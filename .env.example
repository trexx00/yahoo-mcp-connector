# Copy this file to .env and fill in your own values.
# .env is listed in .gitignore, so it never gets uploaded to GitHub.

# Your full Yahoo address, for example someone@yahoo.com
YAHOO_EMAIL=

# The 16-character app password from Yahoo Account Security.
# This is NOT your normal Yahoo password.
YAHOO_APP_PASSWORD=

# Optional settings (the defaults are shown)
# Most emails the server will send per day (UTC). Set to 0 to block sending.
# MAX_SENDS_PER_DAY=20
# Save a copy of each sent email in your Sent folder. If you see every sent
# email twice in Sent, Yahoo is already saving one, so set this to false.
# SAVE_SENT_COPY=true
# Minutes a send/delete preview code stays valid.
# CONFIRM_TTL_MINUTES=10
