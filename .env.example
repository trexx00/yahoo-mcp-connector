# Copy this file to .env and fill in your own values.
# .env is listed in .gitignore, so it never gets uploaded to GitHub.

# Your full Yahoo address, for example someone@yahoo.com
YAHOO_EMAIL=

# The 16-character app password from Yahoo Account Security.
# This is NOT your normal Yahoo password.
YAHOO_APP_PASSWORD=

# Optional settings (the defaults are shown)
# Most emails the server will send per day (UTC). Set to 0 to block sending.
# MAX_SENDS_PER_DAY=20
# Save a copy of each sent email in your Sent folder. If you see every sent
# email twice in Sent, Yahoo is already saving one, so set this to false.
# SAVE_SENT_COPY=true
# Minutes a send/delete preview code stays valid.
# CONFIRM_TTL_MINUTES=10

# --- Sign-in with Amazon Cognito (needed only for `npm run dev:http`) ---
# These are identifiers, not passwords, but keep them out of Git anyway.
# The address Claude uses to reach this server (no /mcp at the end).
# PUBLIC_URL=http://localhost:3000
# From Cognito > User pools > your pool > Overview, e.g. us-east-2_AbC123xyz
# COGNITO_USER_POOL_ID=
# From your pool > App clients > your client
# COGNITO_CLIENT_ID=
# From your pool > Branding > Domain, e.g. https://yahoo-mcp-tj.auth.us-east-2.amazoncognito.com
# COGNITO_DOMAIN=
